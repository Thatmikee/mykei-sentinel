#!/usr/bin/env bash
# Blocks external authorship and tool attribution in commit messages.

MSG="$1"

if grep -qiE "(Co-Authored-By:|Generated with|Generated by|Written with|AI-assisted|AI generated|AI-generated)" "$MSG"; then
  echo ""
  echo "ERROR: Commit rejected. Message contains external attribution."
  echo "Commits in this repository must be authored by Michael Esema only."
  echo "Remove the attribution line and retry."
  echo ""
  exit 1
fi
